{"schema_version":1,"reviewed_at":"2026-08-22","purpose":"N4 standalone atomic rules promoted from explicit coverage gaps. Rules are merged with the N3 atomic contract by tools/normative_full.py.","rules":[{"id":"pagination.pretextual.counted-not-numbered","category":"pagination","requirement":"As folhas ou páginas pré-textuais são contadas, mas não exibem numeração.","locator":"ABNT NBR 14724:2024, 5.3","normativity":"required","kind":"pagination-visibility","values":{"counted":true,"number_visible":false},"validation":{"mode":"automatic","checks":["pretextual"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"pagination.catalog-data.not-counted","category":"pagination","requirement":"Os dados internacionais de catalogação no verso da folha de rosto não são contados nem numerados.","locator":"ABNT NBR 14724:2024, 5.3","normativity":"required","kind":"pagination-exception","values":{"counted":false,"number_visible":false},"applicability":{"context":"title-page-verso-catalog-data"},"validation":{"mode":"automatic","checks":["catalog-card","pretextual"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"pagination.textual.display-start","category":"pagination","requirement":"A numeração visível começa na primeira página da parte textual e usa algarismos arábicos.","locator":"ABNT NBR 14724:2024, 5.3","normativity":"required","kind":"pagination-start","values":{"display_start":"first-textual-page","numeral_system":"arabic"},"validation":{"mode":"automatic","checks":["pretextual","pdf-geometry"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"pagination.recto.position","category":"pagination","requirement":"No anverso, o número da página é colocado no canto superior direito.","locator":"ABNT NBR 14724:2024, 5.3","normativity":"required","kind":"pagination-position","values":{"position":"upper-right"},"validation":{"mode":"automatic","checks":["pdf-geometry"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"paginatio