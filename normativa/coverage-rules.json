n","requirement":"Trabalhos com mais de um volume mantêm uma única sequência de paginação.","locator":"ABNT NBR 14724:2024, 5.3","normativity":"required-when-applicable","kind":"pagination-continuity","values":{"continuous":true},"applicability":{"multiple_volumes":true},"validation":{"mode":"automatic","checks":["multivolume"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"pagination.appendix-annex.continuous","category":"pagination","requirement":"Apêndices e anexos mantêm a sequência de paginação do texto principal.","locator":"ABNT NBR 14724:2024, 5.3","normativity":"required-when-present","kind":"pagination-continuity","values":{"continuous":true},"applicability":{"contexts":["appendix","annex"]},"validation":{"mode":"automatic","checks":["posttextual-compat","duplex-posttextual"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"footnote.line-spacing","category":"footnotes","requirement":"As notas de rodapé usam espaçamento simples.","locator":"ABNT NBR 14724:2024, 5.2.1","normativity":"required","kind":"line-spacing","values":{"factor":1.0},"validation":{"mode":"automatic","checks":["layout"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"footnote.separator.length","category":"footnotes","requirement":"As notas de rodapé são separadas do texto por filete de 5 cm a partir da margem esquerda.","locator":"ABNT NBR 14724:2024, 5.2.1","normativity":"required","kind":"separator","values":{"length_mm":50,"origin":"left-margin"},"validation":{"mode":"automatic","checks":["layout"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"footnote.hanging-alignment","category":"footnotes","requirement":"Linhas subsequentes da nota de rodapé ficam alinhadas sob a primeira letra do texto da primeira linha.","locator":"ABNT NBR 14724:2024, 5.2.1","normativity":"required","kind":"hanging-alignment","values":{"enabled":true},"validation":{"mode":"automatic","checks":["layout"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"section.indicator.alignment","category":"sections","requirement":"O indicativo numérico de seção é alinhado à esquerda.","locator":"ABNT NBR 14724:2024, 5.2.2; ABNT NBR 6024:2012","normativity":"required","kind":"section-indicator","values":{"alignment":"left"},"validation":{"mode":"automatic-partial","checks":["layout"]},"scope":"technical","sources":["abnt-nbr-14724-2024","abnt-nbr-6024-2012"]},{"id":"section.indicator.separator","category":"sections","requirement":"O indicativo numérico é separado do título por um espaço de caractere.","locator":"ABNT NBR 14724:2024, 5.2.2; ABNT NBR 6024:2012","normativity":"required","kind":"section-indicator","values":{"separator":"single-character-space"},"validation":{"mode":"automatic-partial","checks":["layout"]},"scope":"technical","sources":["abnt-nbr-14724-2024","abnt-nbr-6024-2012"]},{"id":"section.primary.recto-duplex","category":"sections","requirement":"Em documentos frente e verso, cada seção primária inicia em página ímpar.","locator":"ABNT NBR 14724:2024, 5.2.2","normativity":"required-when-applicable","kind":"section-break","values":{"start_side":"recto"},"applicability":{"duplex":true},"validation":{"mode":"automatic","checks":["duplex-pretextual","duplex-posttextual"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"section.primary.after-spacing","category":"sections","requirement":"O título de seção primária é separado do texto subsequente por espaço equivalente a 1,5 entrelinhas.","locator":"ABNT NBR 14724:2024, 5.2.2","normativity":"required","kind":"section-spacing","values":{"after_factor":1.5},"validation":{"mode":"automatic-partial","checks":["layout"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"section.subsection.before-after-spacing","category":"sections","requirement":"Títulos de subseções são separados do texto anterior e posterior por espaço equivalente a 1,5 entrelinhas.","locator":"ABNT NBR 14724:2024, 5.2.2","normativity":"required","kind":"section-spacing","values":{"before_factor":1.5,"after_factor":1.5},"validation":{"mode":"automatic-partial","checks":["layout"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"section.multiline.hanging","category":"sections","requirement":"Em título de seção com mais de uma linha, as linhas seguintes ficam alinhadas sob a primeira letra da primeira linha.","locator":"ABNT NBR 14724:2024, 5.2.2","normativity":"required","kind":"hanging-alignment","values":{"enabled":true},"validation":{"mode":"automatic-partial","checks":["layout"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"heading.unnumbered.centered","category":"sections","requirement":"Títulos sem indicativo numérico aplicáveis são centralizados.","locator":"ABNT NBR 14724:2024, 5.2.2","normativity":"required","kind":"unnumbered-heading","values":{"alignment":"centered"},"validation":{"mode":"automatic-partial","checks":["pretextual","reference-corpus","posttextual-compat"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"nature.line-spacing","category":"paragraphs","requirement":"O bloco que descreve natureza, objetivo, instituição e área de concentração usa espaçamento simples.","locator":"ABNT NBR 14724:2024, 5.2","normativity":"required","kind":"line-spacing","values":{"factor":1.0},"validation":{"mode":"automatic-partial","checks":["pretextual"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]},{"id":"nature.block.alignment","category":"pretextual","requirement":"O bloco de natureza é disposto do meio da mancha gráfica até a margem direita.","locator":"ABNT NBR 14724:2024, 5.2","normativity":"required","kind":"block-layout","values":{"horizontal_extent":"mid-text-block-to-right-margin"},"validation":{"mode":"automatic-partial","checks":["pretextual"]},"scope":"technical","sources":["abnt-nbr-14724-2024"]}]}
