{"schema_version":1,"reviewed_at":"2026-08-22","purpose":"N4 pretextual coverage rules.","rules":[{"id":"cover.element.required","category":"pretextual","requirement":"A capa é elemento obrigatório do trabalho acadêmico.","locator":"ABNT NBR 14724:2024 — estrutura; Guia UFC 2022, 3.1.1","normativity":"required","kind":"element-presence","values":{"required":true},"validation":{"mode":"automatic-partial","checks":["pretextual","profiles"]},"scope":"technical","sources":["abnt-nbr-14724-2024","ufc-guia-trabalhos-2022"]},{"id":"cover.fields.order","category":"pretextual","requirement":"A capa apresenta os elementos identificadores na ordem aplicável ao trabalho.","locator":"Guia UFC 2022, 3.1.1","normativity":"institutional-requirement","kind":"field-order","values":{"order":["ufc-emblem","institution","author","title","subtitle-if-present","volume-if-present","city","year"]},"validation":{"mode":"automatic-partial","checks":["pretextual","profiles"]},"scope":"institutional","sources":["ufc-guia-trabalhos-2022"]},{"id":"title-page.element.required","category":"pretextual","requirement":"A folha de rosto é elemento obrigatório.","locator":"ABNT NBR 14724:2024 — elementos pré-textuais; Guia UFC 2022, 3.2.1.1","normativity":"required","kind":"element-presence","values":{"required":true},"validation":{"mode":"automatic-partial","checks":["pretextual","profiles"]},"scope":"technical","sources":["abnt-nbr-14724-2024","ufc-guia-trabalhos-2022"]},{"id":"title-page.fields.order","category":"pretextual","requirement":"O anverso da folha de rosto apresenta autor, título, subtítulo quando houver, volume quando houver, natureza, orientação, local e ano na ordem aplicável.","locator":"Guia UFC 2022, 3.2.1.1","normativity":"institutional-requirement","kind":"field-order","values":{"order":["author","title","subtitle-if-present","volume-if-present","nature","advisor-and-coadvisor-if-present","city","year"]},"validation":{"mode":"automatic-partial","checks":["pretextual","profiles"]},"